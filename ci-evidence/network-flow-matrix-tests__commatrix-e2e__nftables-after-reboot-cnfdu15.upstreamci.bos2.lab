table inet openshift_filter {
	chain OPENSHIFT {
		type filter hook input priority filter + 1; policy accept;
		iif "lo" accept
		ct state established,related accept
		ip protocol icmp accept
		ip6 nexthdr ipv6-icmp accept
		tcp dport { 22, 53, 80, 111, 443, 1936, 2379-2381, 6080, 6443, 9001, 9099-9100, 9103-9105, 9107-9108, 9258, 9443, 9637, 9978-9980, 10250, 10256-10257, 10259, 17697, 22623-22624, 30000-32767 } accept
		udp dport { 53, 68, 111, 30000-32767 } accept
		ip daddr 255.255.255.255 jump {
			limit rate 1/minute burst 5 packets log prefix "firewall "
			drop
		}
		tcp dport 9000-9999 accept
		udp dport 9000-9999 accept
		tcp dport 30000-32767 accept
		udp dport 30000-32767 accept
		tcp dport 10180 accept
		udp dport 10180 accept
		tcp dport 80 accept
		udp dport 80 accept
		jump {
			limit rate 1/minute burst 5 packets log prefix "firewall "
			drop
		}
	}
}
table ip mangle {
	chain KUBE-IPTABLES-HINT {
	}

	chain KUBE-KUBELET-CANARY {
	}

	chain OVN-KUBE-ITP {
	}

	chain OUTPUT {
		type route hook output priority mangle; policy accept;
		counter packets 122090 bytes 154648621 jump OVN-KUBE-ITP
	}
}
table ip filter {
	chain KUBE-FIREWALL {
		ip saddr != 127.0.0.0/8# Warning: table ip filter is managed by iptables-nft, do not touch!
 ip daddr 127.0.0.0/8  ct status dnat counter packets 0 bytes 0 drop
	}

	chain OUTPUT {
		type filter hook output priority filter; policy accept;
		tcp flags syn / fin,syn,rst,ack tcp dport 22624 counter packets 0 bytes 0 reject
		tcp flags syn / fin,syn,rst,ack tcp dport 22623 counter packets 0 bytes 0 reject
		counter packets 155112 bytes 210976422 jump KUBE-FIREWALL
	}

	chain INPUT {
		type filter hook input priority filter; policy accept;
		counter packets 162540 bytes 280079782 jump KUBE-FIREWALL
	}

	chain KUBE-KUBELET-CANARY {
	}

	chain FORWARD {
		type filter hook forward priority filter; policy drop;
		ip daddr 169.254.0.1 counter packets 0 bytes 0 accept
		ip saddr 169.254.0.1 counter packets 0 bytes 0 accept
		ip daddr 172.30.0.0/16 counter packets 0 bytes 0 accept
		ip saddr 172.30.0.0/16 counter packets 0 bytes 0 accept
		ip daddr 10.128.0.0/14 counter packets 0 bytes 0 accept
		ip saddr 10.128.0.0/14 counter packets 0 bytes 0 accept
		tcp flags syn / fin,syn,rst,ack tcp dport 22624 counter packets 0 bytes 0 reject
		tcp flags syn / fin,syn,rst,ack tcp dport 22623 counter packets 0 bytes 0 reject
	}
}
table ip6 mangle {
	chain KUBE-IPTABLES-HINT {
	}

	chain KUBE-KUBELET-CANARY {
	}
}
